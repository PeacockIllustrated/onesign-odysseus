{
  "name": "design-studio-reel",
  "version": "1.0.0",
  "private": true,
  "description": "9:16 motion-graphics reel advertising the Onesign & Digital public sign builder (/design). Standalone Remotion project — not part of the main app build.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts DesignStudioReel out/onesign-design-studio-reel.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell --concurrency=2",
    "still": "remotion still src/index.ts DesignStudioReel out/frame.png --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
