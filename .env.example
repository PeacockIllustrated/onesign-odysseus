# Onesign Odysseus — environment variables
#
# Copy to .env.local and fill in. Validated at startup in lib/env.ts:
# the public Supabase URL + anon key are hard-required; the rest are
# optional at boot but needed for the features noted below.

# ── Supabase (required) ──────────────────────────────────────────────
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Service-role key — BYPASSES RLS. Server-only; never expose to the browser.
# Powers the unauth token flows (/sign-off, /production-sign-off, /delivery)
# and public /design submissions. Required for admin/service operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Mapbox (required for the client site map) ────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-access-token
# Optional: override the default map style.
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# ── Onesign Lynx (optional — QR Links overview at /admin/qr-links) ───
# Read-only window onto Lynx's managed QR/NFC codes and their scan analytics.
# Odysseus never writes to Lynx; links are still managed in Lynx itself.
#
# Set BOTH of these when Lynx runs on its OWN Supabase project:
# LYNX_SUPABASE_URL=https://your-lynx-project.supabase.co
# LYNX_SUPABASE_SERVICE_ROLE_KEY=lynx-service-role-key
#
# Leave both unset when Lynx shares this Supabase project — the page then
# falls back to SUPABASE_SERVICE_ROLE_KEY above (as the Persimmon adapter
# does). Unconfigured is a clean no-op: the page says "not connected".
#
# Host the printed /r/<slug> codes redirect through.
# LYNX_REDIRECT_BASE_URL=https://lynx.onesignanddigital.com
